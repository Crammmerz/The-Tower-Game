card_name = "Fire Zone"
card_description = "Creates a blazing hazard zone that continuously damages enemies within its radius. The zone deals a base fire damage of 5.0 per tick, with damage scaling by +0.05 per point of Strength. As the player’s Strength increases, the FireZone becomes progressively more lethal, making it a reliable area‑control ability against waves of enemies."
